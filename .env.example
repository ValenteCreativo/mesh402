TRIPO_API_KEY=

# Milestone 1: Hedera TESTNET only. Payer and recipient must be different accounts.
HEDERA_PAYER_ACCOUNT_ID=
# ECDSA secp256k1 private key for the payer (hex; never commit the real value).
HEDERA_PAYER_PRIVATE_KEY=
# Your Mesh402 receiving account ID; no recipient private key needed.
HEDERA_PAY_TO_ACCOUNT_ID=

# Agent consumer: Nebius Chat Completions; model used as configured, no discovery/fallback.
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1
NEBIUS_MODEL=Qwen/Qwen3-235B-A22B-Instruct-2507

# Production wrapper. Public replay never requires operator authorization.
NODE_ENV=production
PUBLIC_ORIGIN=https://your-service.onrender.com
LIVE_OPERATOR_SECRET=
# Explicit opt-in only. Do not set live for deployment validation.
MESH402_UI_EXECUTION=dry-run
# PORT is supplied by Render; local default is 4020.

# Independent caller-paid API. Disabled until the real-test authorization.
PUBLIC_API_ENABLED=false
PUBLIC_API_MAX_GENERATIONS=5
PUBLIC_API_MAX_CONCURRENT=1

# Example client ONLY: put these in a separate ignored .env.caller.local.
# Never configure caller keys on Render or implicitly reuse HEDERA_PAYER_*.
MESH402_API_URL=https://mesh402.onrender.com/api/v1/generate
CALLER_HEDERA_ACCOUNT_ID=
CALLER_HEDERA_PRIVATE_KEY=
# Optional recipient trust pin supplied by the caller.
CALLER_EXPECTED_PAY_TO=
