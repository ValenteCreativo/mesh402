{
  "openapi": "3.1.0",
  "info": {
    "title": "Mesh402 caller-paid capability",
    "version": "1.0.0",
    "description": "On-demand 3D asset generation capability for AI agents. Callers pay 0.001 HBAR from their own Hedera testnet wallets using x402 v2 and Blocky402. Successful generation returns a stable public GLB URL."
  },
  "servers": [
    {
      "url": "https://mesh402.onrender.com"
    }
  ],
  "paths": {
    "/api/v1/generate": {
      "post": {
        "operationId": "generate3DAsset",
        "security": [],
        "summary": "Purchase and generate a 3D GLB asset",
        "description": "Submit a prompt to receive HTTP 402 payment requirements. After caller-signed payment is verified and settled through Blocky402 on Hedera testnet, Mesh402 generates and persists one Tripo GLB. No operator authentication is required. A generic API client must implement x402 payment signing to complete this operation. Do not automatically repeat paid requests after errors or timeouts.",
        "parameters": [
          {
            "name": "PAYMENT-SIGNATURE",
            "in": "header",
            "required": false,
            "description": "Base64-encoded x402 v2 payment payload containing x402Version: 2, accepted (the exact offered requirements), resource.url (this endpoint), and payload.transaction (the caller-signed serialized Hedera transfer). Omit on the initial unpaid request.",
            "schema": {
              "type": "string",
              "maxLength": 16000,
              "pattern": "^[A-Za-z0-9+/]+={0,2}$"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "description": "JSON body limited to 16384 bytes. Prompt must contain non-whitespace text and be at most 2000 JavaScript UTF-16 code units.",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/GenerateRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Payment verified and settled; generation succeeded and GLB was persisted. The request waits for completion, which can take several minutes.",
            "headers": {
              "PAYMENT-RESPONSE": {
                "description": "Base64-encoded JSON settlement receipt: success (true), network (hedera:testnet), transaction (Hedera transaction ID), payer (caller account ID).",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GeneratedAsset"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request or payment.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "error"
                  ],
                  "properties": {
                    "error": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "code"
                      ],
                      "properties": {
                        "code": {
                          "type": "string",
                          "enum": [
                            "invalid_prompt",
                            "invalid_json",
                            "malformed_payment",
                            "payment_requirements_mismatch",
                            "payment_resource_mismatch",
                            "payment_transfer_mismatch"
                          ]
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "402": {
            "description": "Payment required, or caller payment verification failed. The header encodes the same JSON body. Read recipient and feePayer dynamically from this offer; sign with the caller wallet and submit the same prompt once with PAYMENT-SIGNATURE.",
            "headers": {
              "PAYMENT-REQUIRED": {
                "description": "Base64-encoded x402 v2 PaymentRequired JSON, identical to the response body.",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PaymentRequired"
                }
              }
            }
          },
          "409": {
            "description": "Execution blocked by an active, previously attempted, or ambiguous payment. Do not automatically retry.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "error"
                  ],
                  "properties": {
                    "error": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "code"
                      ],
                      "properties": {
                        "code": {
                          "type": "string",
                          "enum": [
                            "generation_in_progress",
                            "payment_already_attempted",
                            "reconciliation_required"
                          ]
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "413": {
            "description": "Request body exceeds 16384 bytes.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "error"
                  ],
                  "properties": {
                    "error": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "code"
                      ],
                      "properties": {
                        "code": {
                          "type": "string",
                          "enum": [
                            "body_too_large"
                          ]
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "415": {
            "description": "Content-Type must be application/json.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "error"
                  ],
                  "properties": {
                    "error": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "code"
                      ],
                      "properties": {
                        "code": {
                          "type": "string",
                          "enum": [
                            "json_required"
                          ]
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "429": {
            "description": "Public generation quota exhausted.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "error"
                  ],
                  "properties": {
                    "error": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "code"
                      ],
                      "properties": {
                        "code": {
                          "type": "string",
                          "enum": [
                            "quota_exhausted"
                          ]
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "502": {
            "description": "Execution requires human reconciliation. Payment may already have settled and a generation may exist. Never automatically repeat the payment or generation. PAYMENT-RESPONSE may be present if settlement was confirmed before failure.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "error",
                    "paid",
                    "transactionId",
                    "taskId",
                    "retryable"
                  ],
                  "properties": {
                    "error": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "code"
                      ],
                      "properties": {
                        "code": {
                          "type": "string",
                          "enum": [
                            "execution_requires_reconciliation"
                          ]
                        }
                      }
                    },
                    "paid": {
                      "oneOf": [
                        {
                          "type": "boolean"
                        },
                        {
                          "type": "string",
                          "enum": [
                            "unknown"
                          ]
                        }
                      ]
                    },
                    "transactionId": {
                      "type": "string"
                    },
                    "taskId": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "retryable": {
                      "type": "boolean",
                      "enum": [
                        false
                      ]
                    }
                  }
                }
              }
            }
          },
          "503": {
            "description": "Public API disabled, not configured, unavailable, or facilitator discovery unavailable.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "error"
                  ],
                  "properties": {
                    "error": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "code"
                      ],
                      "properties": {
                        "code": {
                          "type": "string",
                          "enum": [
                            "public_api_disabled",
                            "public_api_not_configured",
                            "facilitator_unavailable",
                            "public_api_unavailable"
                          ]
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "GenerateRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "prompt"
        ],
        "properties": {
          "prompt": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000,
            "pattern": "\\S",
            "description": "Description of the requested 3D asset. Leading and trailing whitespace is trimmed."
          }
        }
      },
      "PaymentRequirements": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "scheme",
          "network",
          "amount",
          "asset",
          "payTo",
          "maxTimeoutSeconds",
          "extra"
        ],
        "properties": {
          "scheme": {
            "type": "string",
            "enum": [
              "exact"
            ]
          },
          "network": {
            "type": "string",
            "enum": [
              "hedera:testnet"
            ]
          },
          "amount": {
            "type": "string",
            "enum": [
              "100000"
            ]
          },
          "asset": {
            "type": "string",
            "enum": [
              "0.0.0"
            ]
          },
          "payTo": {
            "type": "string",
            "pattern": "^0\\.0\\.[0-9]+$"
          },
          "maxTimeoutSeconds": {
            "type": "integer",
            "enum": [
              120
            ]
          },
          "extra": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "feePayer"
            ],
            "properties": {
              "feePayer": {
                "type": "string",
                "pattern": "^0\\.0\\.[0-9]+$"
              }
            }
          }
        }
      },
      "PaymentRequired": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "x402Version",
          "resource",
          "accepts"
        ],
        "properties": {
          "x402Version": {
            "type": "integer",
            "enum": [
              2
            ]
          },
          "resource": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "url",
              "description",
              "mimeType"
            ],
            "properties": {
              "url": {
                "type": "string",
                "format": "uri"
              },
              "description": {
                "type": "string",
                "enum": [
                  "Caller-paid Mesh402 Tripo GLB generation"
                ]
              },
              "mimeType": {
                "type": "string",
                "enum": [
                  "application/json"
                ]
              }
            }
          },
          "accepts": {
            "type": "array",
            "minItems": 1,
            "maxItems": 1,
            "items": {
              "$ref": "#/components/schemas/PaymentRequirements"
            }
          },
          "error": {
            "type": "string",
            "enum": [
              "payment_verification_failed"
            ]
          }
        }
      },
      "GeneratedAsset": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "status",
          "network",
          "price",
          "amountTinybars",
          "transactionId",
          "payer",
          "recipient",
          "verificationValid",
          "settlementSuccess",
          "taskId",
          "assetUrl",
          "receiptUrl",
          "creditsConsumed",
          "glbBytes",
          "prompt"
        ],
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "success"
            ]
          },
          "network": {
            "type": "string",
            "enum": [
              "hedera:testnet"
            ]
          },
          "price": {
            "type": "string",
            "enum": [
              "0.001 HBAR"
            ]
          },
          "amountTinybars": {
            "type": "string",
            "enum": [
              "100000"
            ]
          },
          "transactionId": {
            "type": "string"
          },
          "payer": {
            "type": "string",
            "pattern": "^0\\.0\\.[0-9]+$"
          },
          "recipient": {
            "type": "string",
            "pattern": "^0\\.0\\.[0-9]+$"
          },
          "verificationValid": {
            "type": "boolean",
            "enum": [
              true
            ]
          },
          "settlementSuccess": {
            "type": "boolean",
            "enum": [
              true
            ]
          },
          "taskId": {
            "type": "string",
            "pattern": "^[a-f0-9-]{36}$"
          },
          "assetUrl": {
            "type": "string",
            "format": "uri",
            "description": "Stable public URL for the persisted GLB."
          },
          "receiptUrl": {
            "type": "string",
            "format": "uri",
            "description": "Public sanitized receipt URL for this generation."
          },
          "creditsConsumed": {
            "type": [
              "number",
              "null"
            ]
          },
          "glbBytes": {
            "type": "integer",
            "minimum": 0
          },
          "prompt": {
            "type": "string",
            "description": "The trimmed generation prompt."
          }
        }
      }
    }
  }
}
